# Firebase Client (lấy từ Project Settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (paste TOÀN BỘ JSON service account dưới dạng 1 dòng string,
# hoặc dùng dấu nháy đơn nếu shell hỗ trợ)
FIREBASE_ADMIN_CREDENTIALS=

# Google Drive Service Account (paste JSON service account ở đây — có thể trùng
# với FIREBASE_ADMIN_CREDENTIALS nếu bạn dùng cùng 1 GCP project và đã bật Drive API)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=DriveSelect <onboarding@resend.dev>
ADMIN_EMAIL=your@email.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
